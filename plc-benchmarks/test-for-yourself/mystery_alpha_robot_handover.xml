<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <types><pous><pou name="Dual_Arm_Robotic_Handover" pouType="program"><body><LD>
    <leftPowerRail localId="1"/>
    <!-- Rung 1: Part Staged at Handover Nest + Safety Curtain -> Robot Alpha Tool Head Set -->
    <contact localId="2" negated="false"><variable>%IX0.4</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <contact localId="3" negated="false"><variable>%IX0.0</variable><connectionPointIn><connection refLocalId="2"/></connectionPointIn></contact>
    <coil localId="4" storage="set"><variable>%QX0.1</variable><connectionPointIn><connection refLocalId="3"/></connectionPointIn></coil>
    <!-- Rung 2: Robot Alpha In-Nest -> Handover Dwell Timer T4:7 -->
    <contact localId="5" negated="false"><variable>%QX0.1</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <block localId="6" typeName="TON" instanceName="T4:7"><inputVariables><variable formalParameter="IN"><connectionPointIn><connection refLocalId="5"/></connectionPointIn></variable><variable formalParameter="PT"><expression>T#300ms</expression></variable></inputVariables></block>
    <!-- Rung 3: Dwell Complete + Alpha Departure Switch -> Reset Robot Alpha In-Nest -->
    <contact localId="7" negated="false"><variable>T4:7.DN</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <contact localId="8" negated="false"><variable>%IX0.2</variable><connectionPointIn><connection refLocalId="7"/></connectionPointIn></contact>
    <coil localId="9" storage="reset"><variable>%QX0.1</variable><connectionPointIn><connection refLocalId="8"/></connectionPointIn></coil>
    <!-- Rung 4: Handover Trigger + Beta Request -> Robot Beta Gripper Jaw (Missing Alpha Departure Interlock!) -->
    <contact localId="10" negated="false"><variable>T4:7.DN</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <contact localId="11" negated="false"><variable>%IX0.5</variable><connectionPointIn><connection refLocalId="10"/></connectionPointIn></contact>
    <coil localId="12"><variable>%QX0.3</variable><connectionPointIn><connection refLocalId="11"/></connectionPointIn></coil>
    <!-- Rung 5: Fixture Nest Rotary Table Indexer -->
    <contact localId="13" negated="false"><variable>%IX0.3</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <coil localId="14"><variable>%QX0.2</variable><connectionPointIn><connection refLocalId="13"/></connectionPointIn></coil>
    <!-- Rung 6: Perimeter Warning Strobe Beacon -->
    <contact localId="15" negated="false"><variable>%IX0.5</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <coil localId="16"><variable>%QX0.5</variable><connectionPointIn><connection refLocalId="15"/></connectionPointIn></coil>
  </LD></body></pou></pous></types>
</project>