<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <types><pous><pou name="Stamping_Press_Cell" pouType="program"><body><LD>
    <leftPowerRail localId="1"/>
    <!-- Rung 1: Part In Die + Two-Hand PB + Light Curtain -> Feeder Arm Set -->
    <contact localId="2" negated="false"><variable>%IX0.4</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <contact localId="3" negated="false"><variable>%IX0.5</variable><connectionPointIn><connection refLocalId="2"/></connectionPointIn></contact>
    <contact localId="4" negated="false"><variable>%IX0.3</variable><connectionPointIn><connection refLocalId="3"/></connectionPointIn></contact>
    <coil localId="5" storage="set"><variable>%QX0.1</variable><connectionPointIn><connection refLocalId="4"/></connectionPointIn></coil>
    <!-- Rung 2: Feeder Arm Active -> Dwell Timer T4:0 -->
    <contact localId="6" negated="false"><variable>%QX0.1</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <block localId="7" typeName="TON" instanceName="T4:0"><inputVariables><variable formalParameter="IN"><connectionPointIn><connection refLocalId="6"/></connectionPointIn></variable><variable formalParameter="PT"><expression>T#200ms</expression></variable></inputVariables></block>
    <!-- Rung 3: Dwell Done + Arm At Die Prox -> Reset Feeder Arm -->
    <contact localId="8" negated="false"><variable>T4:0.DN</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <contact localId="9" negated="false"><variable>%IX0.2</variable><connectionPointIn><connection refLocalId="8"/></connectionPointIn></contact>
    <coil localId="10" storage="reset"><variable>%QX0.1</variable><connectionPointIn><connection refLocalId="9"/></connectionPointIn></coil>
    <!-- Rung 4: Feeder Arm Active -> Ram Stroke Delay Timer T4:1 -->
    <contact localId="11" negated="false"><variable>%QX0.1</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <block localId="12" typeName="TON" instanceName="T4:1"><inputVariables><variable formalParameter="IN"><connectionPointIn><connection refLocalId="11"/></connectionPointIn></variable><variable formalParameter="PT"><expression>T#300ms</expression></variable></inputVariables></block>
    <!-- Rung 5: Ram Timer Done -> Stroke Hydraulic Ram (Missing Arm Retract Interlock!) -->
    <contact localId="13" negated="false"><variable>T4:1.DN</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <coil localId="14"><variable>%QX0.0</variable><connectionPointIn><connection refLocalId="13"/></connectionPointIn></coil>
    <!-- Rung 6: Master Safety Enable -> Infeed Blank Conveyor -->
    <contact localId="15" negated="false"><variable>%IX0.4</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <coil localId="16"><variable>%QX0.2</variable><connectionPointIn><connection refLocalId="15"/></connectionPointIn></coil>
  </LD></body></pou></pous></types>
</project>