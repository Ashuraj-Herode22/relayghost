<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <types><pous><pou name="Conveyor_Sorting_Diverter" pouType="program"><body><LD>
    <leftPowerRail localId="1"/>
    <!-- Rung 1: Main Infeed Belt Run -->
    <contact localId="2" negated="false"><variable>%IX0.4</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <coil localId="3"><variable>%QX0.2</variable><connectionPointIn><connection refLocalId="2"/></connectionPointIn></coil>
    <!-- Rung 2: Infeed Photocell + Barcode Divert Command -> Pusher Ram Set -->
    <contact localId="4" negated="false"><variable>%IX0.0</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <contact localId="5" negated="false"><variable>%IX0.5</variable><connectionPointIn><connection refLocalId="4"/></connectionPointIn></contact>
    <coil localId="6" storage="set"><variable>%QX0.1</variable><connectionPointIn><connection refLocalId="5"/></connectionPointIn></coil>
    <!-- Rung 3: Pusher Ram Active -> Transfer Dwell Timer T4:4 -->
    <contact localId="7" negated="false"><variable>%QX0.1</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <block localId="8" typeName="TON" instanceName="T4:4"><inputVariables><variable formalParameter="IN"><connectionPointIn><connection refLocalId="7"/></connectionPointIn></variable><variable formalParameter="PT"><expression>T#300ms</expression></variable></inputVariables></block>
    <!-- Rung 4: Dwell Complete + Pusher Stroke Limit -> Retract Pusher Ram -->
    <contact localId="9" negated="false"><variable>T4:4.DN</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <contact localId="10" negated="false"><variable>%IX0.2</variable><connectionPointIn><connection refLocalId="9"/></connectionPointIn></contact>
    <coil localId="11" storage="reset"><variable>%QX0.1</variable><connectionPointIn><connection refLocalId="10"/></connectionPointIn></coil>
    <!-- Rung 5: Divert Command -> Swing Diverter Gate Blade (Missing Pusher Retract Interlock!) -->
    <contact localId="12" negated="false"><variable>T4:4.DN</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <coil localId="13"><variable>%QX0.3</variable><connectionPointIn><connection refLocalId="12"/></connectionPointIn></coil>
    <!-- Rung 6: Divert Confirm Photocell -> Discharge Chute Rollers -->
    <contact localId="14" negated="false"><variable>%IX0.3</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <coil localId="15"><variable>%QX0.5</variable><connectionPointIn><connection refLocalId="14"/></connectionPointIn></coil>
  </LD></body></pou></pous></types>
</project>