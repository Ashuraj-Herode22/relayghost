<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <types><pous><pou name="Thermal_Curing_Autoclave" pouType="program"><body><LD>
    <leftPowerRail localId="1"/>
    <!-- Rung 1: Chamber Door Closed + Interlock -> Purge Blower Set -->
    <contact localId="2" negated="false"><variable>%IX0.0</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <contact localId="3" negated="false"><variable>%IX0.4</variable><connectionPointIn><connection refLocalId="2"/></connectionPointIn></contact>
    <coil localId="4" storage="set"><variable>%QX0.1</variable><connectionPointIn><connection refLocalId="3"/></connectionPointIn></coil>
    <!-- Rung 2: Purge Blower Active -> NFPA 86 Purge Timer T4:6 -->
    <contact localId="5" negated="false"><variable>%QX0.1</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <block localId="6" typeName="TON" instanceName="T4:6"><inputVariables><variable formalParameter="IN"><connectionPointIn><connection refLocalId="5"/></connectionPointIn></variable><variable formalParameter="PT"><expression>T#300ms</expression></variable></inputVariables></block>
    <!-- Rung 3: Purge Dwell Complete + Chamber Pressure Switch -> Reset Purge Latch -->
    <contact localId="7" negated="false"><variable>T4:6.DN</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <contact localId="8" negated="false"><variable>%IX0.2</variable><connectionPointIn><connection refLocalId="7"/></connectionPointIn></contact>
    <coil localId="9" storage="reset"><variable>%QX0.1</variable><connectionPointIn><connection refLocalId="8"/></connectionPointIn></coil>
    <!-- Rung 4: Temperature Controller Demand -> 480V Heating Bank (Ignition before Purge Verified!) -->
    <contact localId="10" negated="false"><variable>T4:6.DN</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <contact localId="11" negated="false"><variable>%IX0.5</variable><connectionPointIn><connection refLocalId="10"/></connectionPointIn></contact>
    <coil localId="12"><variable>%QX0.0</variable><connectionPointIn><connection refLocalId="11"/></connectionPointIn></coil>
    <!-- Rung 5: Hearth Carriage In-Position -> Rail Carriage Drive -->
    <contact localId="13" negated="false"><variable>%IX0.4</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <coil localId="14"><variable>%QX0.2</variable><connectionPointIn><connection refLocalId="13"/></connectionPointIn></coil>
    <!-- Rung 6: Exhaust Thermal Strobe Beacon -->
    <contact localId="15" negated="false"><variable>%IX0.3</variable><connectionPointIn><connection refLocalId="1"/></connectionPointIn></contact>
    <coil localId="16"><variable>%QX0.5</variable><connectionPointIn><connection refLocalId="15"/></connectionPointIn></coil>
  </LD></body></pou></pous></types>
</project>